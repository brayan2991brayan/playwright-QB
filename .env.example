# 🔧 QBench Automation Environment Variables
# Copy this file to .env and fill in your actual values

# QBench Application URL
QBENCH_BASE_URL=https://srqaengineer-ba-uat.qbench.net

# QBench Login Credentials
QBENCH_USERNAME=melvin+qaengineer@qbench.com
QBENCH_PASSWORD=your_password_here

# Optional: Playwright Configuration
# PLAYWRIGHT_BROWSERS_PATH=0
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=false

# Optional: Test Configuration
# HEADLESS=true
# TIMEOUT=30000
# RETRIES=2

# Notes:
# - Replace 'your_password_here' with your actual QBench password
# - All other values are pre-configured for QBench UAT environment
# - Never commit the .env file to git (it's in .gitignore)
# - For GitHub Actions, configure these as repository secrets instead
